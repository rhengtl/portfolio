---
/** Title, description, canonical, Open Graph / Twitter and optional JSON-LD (PORTFOLIO_SPEC §22). */
import { site } from '@/data/site';

interface Props {
  /** Page-specific title. Omit on the home page to use the site title. */
  title?: string;
  description?: string;
  /** Root-relative path to a 1200×630 social image (public/og/, made by scripts/og.mjs). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = '/og/default.png',
  imageAlt = `${site.name} — ${site.title}`,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.seoTitle;
// With `build.format: 'file'` the pathname ends in ".html"; canonical URLs use clean paths.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content="1200" />}
{imageUrl && <meta property="og:image:height" content="630" />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
