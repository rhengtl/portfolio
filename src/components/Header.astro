---
/**
 * Sticky site header.
 * - Desktop/tablet: inline nav. Mobile: disclosure menu (only when JS is available).
 * - Without JS the nav links stay visible and wrap, so nothing is unreachable.
 * - Active-section highlighting runs only on the home page.
 */
import { nav, site } from '@/data/site';
import { hasResume } from '@/lib/resume';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <span class="site-header__monogram" aria-hidden="true">
        {site.shortName}
      </span>
      <span class="site-header__name">{site.name}</span>
    </a>

    {/* Directly before the nav it controls: once open, Tab moves from the button into the links. */}
    <button
      type="button"
      class="site-header__menu-button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
      hidden
    >
      <span class="visually-hidden">Menu</span>
      <Icon name="menu" class="site-header__icon-open" />
      <Icon name="close" class="site-header__icon-close" />
    </button>

    <nav class="site-header__nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} data-nav-link={item.href.split('#')[1]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      {hasResume && (
        <a
          class="site-header__resume"
          href={site.resumePath}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="file" size={16} />
          Résumé<span class="visually-hidden"> (PDF, opens in new tab)</span>
        </a>
      )}
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const navEl = document.getElementById('site-nav');

  if (header && menuButton && navEl) {
    menuButton.hidden = false;

    const setOpen = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-menu-open', open);
    };

    menuButton.addEventListener('click', () => {
      setOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    // Close on link click, Escape, or a click outside the header.
    navEl.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuButton.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    // Raised shadow once the page has scrolled.
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Active section (home page only): highlight the nav item for the section in view.
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of navEl.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')) {
      const id = link.dataset.navLink;
      if (id && document.getElementById(id)) links.set(id, link);
    }

    if (links.size > 0 && 'IntersectionObserver' in window) {
      // Track which sections cross the band; highlight the first one, or none (e.g. on the hero).
      const inBand = new Set<string>();
      const ids = [...links.keys()];
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inBand.add(entry.target.id);
            else inBand.delete(entry.target.id);
          }
          const current = ids.find((id) => inBand.has(id));
          for (const [id, link] of links) {
            if (id === current) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      for (const id of links.keys()) observer.observe(document.getElementById(id)!);
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .site-header[data-scrolled],
  .site-header[data-menu-open] {
    border-bottom-color: var(--border);
  }

  .site-header[data-menu-open] {
    box-shadow: var(--shadow-raised);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    min-height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }

  .site-header__monogram {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--text);
    border-radius: var(--radius-sm);
    font-family: var(--font-code);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* Visually hidden below desktop (not display:none) so the link keeps "Rhenier Gustilo" as its name. */
  .site-header__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .site-header__nav a[aria-current='true'] {
    color: var(--accent);
  }

  @media (hover: hover) {
    .site-header__nav a:hover {
      color: var(--text);
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .site-header__resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__menu-button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .site-header__menu-button[hidden] {
    display: none;
  }

  .site-header__menu-button :global(.site-header__icon-close) {
    display: none;
  }

  .site-header__menu-button[aria-expanded='true'] :global(.site-header__icon-close) {
    display: block;
  }

  .site-header__menu-button[aria-expanded='true'] :global(.site-header__icon-open) {
    display: none;
  }

  /* Mobile with JS: nav collapses into a full-width disclosure list under the bar. */
  @media (max-width: 39.99rem) {
    :global(.js) .site-header__nav {
      display: none;
      order: 3;
      width: 100%;
      padding-bottom: var(--space-3);
    }

    :global(.js) .site-header[data-menu-open] .site-header__nav {
      display: block;
    }

    :global(.js) .site-header__nav ul {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .site-header__nav li + li {
      border-top: var(--hairline);
    }

    :global(.js) .site-header__nav a {
      width: 100%;
      font-size: var(--text-body);
    }

    /* Without JS the nav wraps onto its own row below the brand. */
    .site-header__nav {
      order: 3;
      width: 100%;
    }

    /* Visual row: brand · theme toggle · menu button (DOM order puts the button before the nav). */
    .site-header__inner {
      column-gap: var(--space-2);
    }

    .site-header__actions {
      order: 1;
    }

    .site-header__menu-button {
      order: 2;
    }
  }

  @media (min-width: 40rem) {
    .site-header__menu-button {
      display: none !important;
    }

    .site-header__inner {
      flex-wrap: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .site-header__name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }
</style>
