---
/** Email link plus a copy button with an aria-live confirmation (PORTFOLIO_SPEC §16, §21). */
import { site } from '@/data/site';
import Icon from './Icon.astro';
---

<div class="copy-email" data-copy-email>
  <a class="copy-email__link" href={`mailto:${site.email}`}>
    <Icon name="mail" size={18} />
    {site.email}
  </a>
  <button type="button" class="copy-email__button" data-copy-value={site.email} hidden>
    <Icon name="copy" size={16} class="copy-email__icon-copy" />
    <Icon name="check" size={16} class="copy-email__icon-done" />
    <span data-copy-label>Copy</span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-copy-status></span>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-copy-email]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-value]');
    const label = root.querySelector<HTMLElement>('[data-copy-label]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !label || !status || !navigator.clipboard) continue;

    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyValue ?? '');
        button.dataset.copied = 'true';
        label.textContent = 'Copied';
        status.textContent = 'Email address copied to clipboard';
      } catch {
        status.textContent = 'Could not copy. Select the address instead.';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        label.textContent = 'Copy';
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .copy-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .copy-email__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-lead);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .copy-email__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border: var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: var(--text-small);
    font-weight: 500;
    cursor: pointer;
  }

  .copy-email__button[hidden] {
    display: none;
  }

  .copy-email__button :global(.copy-email__icon-done) {
    display: none;
  }

  .copy-email__button[data-copied] :global(.copy-email__icon-done) {
    display: block;
    color: var(--accent);
  }

  .copy-email__button[data-copied] :global(.copy-email__icon-copy) {
    display: none;
  }
</style>
