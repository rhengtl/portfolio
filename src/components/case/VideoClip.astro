---
/**
 * Short muted demo clip for a case-study Figure: native controls, never autoplays, and nothing is
 * downloaded until it's needed. Browsers fetch `poster` eagerly even with preload="none", which
 * competes with the page's main image, so the poster is attached only as the clip nears the
 * viewport. Without JavaScript the clip still plays; it just has no preview frame.
 */
interface Props {
  /** Path under public/, e.g. /media/clip.mp4 (H.264, faststart, ≤ 3 MB). */
  src: string;
  poster: string;
  width: number;
  height: number;
  /** Accessible name; the Figure caption carries the full description. */
  label: string;
}

const { src, poster, width, height, label } = Astro.props;
---

<video
  class="clip"
  controls
  muted
  playsinline
  preload="none"
  data-poster={poster}
  width={width}
  height={height}
  aria-label={label}
>
  <source src={src} type="video/mp4" />
  <a href={src}>Download the clip (MP4)</a>
</video>

<script>
  const clips = document.querySelectorAll<HTMLVideoElement>('video[data-poster]');
  const attach = (v: HTMLVideoElement) => {
    v.poster = v.dataset.poster ?? '';
    v.removeAttribute('data-poster');
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            attach(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '600px 0px' },
    );
    clips.forEach((v) => io.observe(v));
  } else {
    clips.forEach(attach);
  }
</script>

<style>
  .clip {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
  }

  /* The native controls live in the browser's shadow DOM and draw no ring of their own; the host
     matches :focus while any control inside has focus. Inset because the figure frame clips. */
  .clip:focus {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
</style>
