---
/**
 * Numbered figure for case studies: an image or slotted content
 * (diagram, chart) in a bordered frame with "Fig. n — caption".
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  number: number;
  caption: string;
  src?: ImageMetadata;
  alt?: string;
  /** Wider than the prose column on desktop (up to 960 px). */
  wide?: boolean;
  /** Narrow portrait images (phone screenshots) are capped so they don't tower. */
  maxWidth?: string;
}

const { number, caption, src, alt = '', wide = false, maxWidth } = Astro.props;
---

<figure class:list={['figure', { 'figure--wide': wide }]}>
  <div class="figure__frame" style={maxWidth ? `max-width: ${maxWidth}` : undefined}>
    {src ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        layout="constrained"
        width={Math.min(src.width, 960)}
        height={Math.round((Math.min(src.width, 960) / src.width) * src.height)}
        sizes="(min-width: 64rem) 960px, calc(100vw - 2rem)"
        quality={72}
      />
    ) : (
      <slot />
    )}
  </div>
  <figcaption>
    <span class="figure__number">Fig. {number}</span> — {caption}
  </figcaption>
</figure>

<style>
  .figure {
    margin: var(--space-7) 0;
  }

  .figure__frame {
    overflow: hidden;
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .figure__frame :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-small);
    color: var(--muted);
  }

  .figure__number {
    font-family: var(--font-code);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }

  @media (min-width: 64rem) {
    .figure--wide {
      width: min(var(--figure-max), calc(100vw - 2 * var(--gutter)));
    }
  }
</style>
