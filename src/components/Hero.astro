---
import { site } from '@/data/site';
import { hasResume } from '@/lib/resume';
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
---

<section class="hero" aria-labelledby="hero-role">
  <div class="container hero__inner">
    <p class="label hero__name">{site.name}</p>
    <h1 id="hero-role">
      Software Engineer<span>AI Applications &amp; Backend Development</span>
    </h1>
    <p class="hero__mission">{site.mission}</p>
    <p class="hero__availability">{site.availability}</p>
    <div class="hero__actions">
      <LinkButton href="/#projects" variant="primary">
        View Projects <Icon name="arrow-right" size={16} />
      </LinkButton>
      {hasResume && (
        <LinkButton href={site.resumePath} download>
          <Icon name="file" size={16} /> Download Resume <span class="visually-hidden">(PDF)</span>
        </LinkButton>
      )}
      <a class="hero__contact" href="/#contact">
        Contact Me <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <nav class="hero__work" aria-label="Jump to selected work">
      <a href="/#project-contex">
        <strong>ConTeX</strong>
        <span>AI conversion API &amp; browser LaTeX</span>
      </a>
      <a href="/#project-tindabot">
        <strong>TindaBot</strong>
        <span>Offline data, sync &amp; AI drafts</span>
      </a>
      <a href="/#project-earprompt">
        <strong>EarPrompt</strong>
        <span>Speech pipeline &amp; device API</span>
      </a>
    </nav>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-4);
  }
  .hero__name {
    color: var(--accent);
  }
  h1 {
    max-width: 60rem;
  }
  h1 span {
    display: block;
    margin-top: var(--space-2);
    font-size: clamp(1.5rem, 1.15rem + 1.7vw, 2.5rem);
    line-height: 1.2;
    font-weight: 500;
  }
  .hero__mission {
    max-width: 49rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--muted);
  }
  .hero__availability {
    font-size: var(--text-small);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }
  .hero__contact {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-2);
    font-weight: 500;
    font-size: var(--text-small);
  }
  .hero__work {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--hairline);
  }
  .hero__work a {
    display: grid;
    gap: var(--space-1);
    min-height: 44px;
    text-decoration: none;
    color: var(--text);
  }
  .hero__work strong {
    font-weight: 600;
  }
  .hero__work span {
    color: var(--muted);
    font-size: var(--text-small);
  }
  @media (hover: hover) {
    .hero__work a:hover strong {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  @media (min-width: 40rem) {
    .hero__work {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-8);
    }
  }
</style>
