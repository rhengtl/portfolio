---
import { site, socials } from '@/data/site';
import Icon from './Icon.astro';

const updated = new Date(`${site.lastUpdated}-01T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__signoff">
      {site.name} · {site.title}
    </p>

    <ul class="site-footer__links" aria-label="Elsewhere">
      {socials.map((link) => (
        <li>
          <a href={link.href} rel={link.icon === 'mail' ? undefined : 'me'}>
            <Icon name={link.icon} size={18} />
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="site-footer__meta label">
      <span>Last updated {updated}</span>
      {site.sourceRepo && (
        <>
          <span aria-hidden="true">·</span>
          <a href={site.sourceRepo}>Built with Astro, view source</a>
        </>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    padding-block: var(--space-7);
    margin-top: var(--space-8);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__signoff {
    color: var(--muted);
    font-size: var(--text-small);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-small);
  }

  @media (hover: hover) {
    .site-footer__links a:hover {
      color: var(--accent);
    }
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    text-transform: none;
    letter-spacing: 0;
  }

  .site-footer__meta a {
    color: var(--muted);
  }
</style>
