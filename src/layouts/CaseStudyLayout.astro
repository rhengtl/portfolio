---
/**
 * Case-study page (PORTFOLIO_SPEC §9.2): header + meta strip + links, TL;DR, hero media,
 * the MDX body (problem → architecture → contribution → challenges → results → limitations),
 * then "Next project".
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import TagList from '@/components/TagList.astro';
import { evidenceLinks, projectLabel, yearRange, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const tldr = data.tldr!;
const links = evidenceLinks(project);
// Per-project social image from scripts/og.mjs; the site default otherwise.
const ogImage = existsSync(join(process.cwd(), 'public', 'og', `${project.id}.png`))
  ? `/og/${project.id}.png`
  : undefined;
const STATUS: Record<string, string> = {
  live: 'Live',
  released: 'Released',
  thesis: 'Thesis prototype',
  prototype: 'Prototype',
};
---

<BaseLayout
  title={`${data.title} — ${data.seoTitle ?? data.tagline.replace(/\.$/, '')}`}
  description={data.description ?? data.summary}
  image={ogImage}
  imageAlt={ogImage ? `${data.title}: ${data.tagline}` : undefined}
  type="article"
>
  <article class="case">
    <header class="container case__header">
      <a class="case__back" href="/#projects">
        <span aria-hidden="true">←</span> All projects
      </a>
      <p class="label">{projectLabel(project)}</p>
      <h1>{data.title}</h1>
      <p class="case__tagline">{data.tagline}</p>

      <dl class="case__meta">
        <div>
          <dt class="label">Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt class="label">Team</dt>
          <dd>{data.scope}</dd>
        </div>
        <div>
          <dt class="label">Timeline</dt>
          <dd>{data.period ?? yearRange(data.timeline)}</dd>
        </div>
        <div>
          <dt class="label">Status</dt>
          <dd>{STATUS[data.status]}</dd>
        </div>
        <div class="case__meta-stack">
          <dt class="label">Stack</dt>
          <dd>
            <TagList items={data.stack} label={`${data.title} technologies`} />
          </dd>
        </div>
      </dl>

      {links.length > 0 && (
        <ul class="case__links" aria-label={`${data.title} links`}>
          {links.map((link) => (
            <li>
              <a href={link.href} class="case__link">
                {link.label}
                <Icon name="external" size={14} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="container">
      <section class="tldr" aria-labelledby="tldr-heading">
        <h2 id="tldr-heading" class="label">
          TL;DR
        </h2>
        <dl>
          <div>
            <dt>Problem</dt>
            <dd>{tldr.problem}</dd>
          </div>
          <div>
            <dt>What I built</dt>
            <dd>{tldr.built}</dd>
          </div>
          <div>
            <dt>Result</dt>
            <dd>{tldr.result}</dd>
          </div>
        </dl>
      </section>

      {data.cover && data.coverAlt && (
        <figure class="case__hero">
          <Picture
            src={data.cover}
            alt={data.coverAlt}
            formats={['avif', 'webp']}
            layout="constrained"
            width={832}
            height={520}
            sizes="(min-width: 56rem) 832px, calc(100vw - 2rem)"
            style={`view-transition-name: cover-${project.id}`}
            fit="cover"
            quality={72}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="case__body prose">
        <slot />
      </div>

      {next && (
        <nav class="case__next" aria-label="Next project">
          <p class="label">Next project</p>
          <a href={`/projects/${next.id}`}>
            <span class="case__next-title">{next.data.title}</span>
            <span class="case__next-tagline">{next.data.tagline}</span>
            <Icon name="arrow-right" size={20} />
          </a>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .case__header {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-6);
  }

  .case__header > * {
    max-width: 52rem;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    width: fit-content;
    color: var(--muted);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
  }

  @media (hover: hover) {
    .case__back:hover {
      color: var(--accent);
    }
  }

  .case__tagline {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--muted);
  }

  .case__meta {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-4);
    border-top: var(--hairline);
    font-size: var(--text-small);
  }

  .case__meta div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .case__meta dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .case__meta {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }

    .case__meta-stack {
      grid-column: 1 / -1;
    }
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .case__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-weight: 500;
  }

  .tldr {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    padding: var(--space-5);
    border: var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .tldr dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .tldr dl div {
    display: grid;
    gap: var(--space-1);
  }

  .tldr dt {
    font-weight: 600;
  }

  .tldr dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .tldr dl div {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  .case__hero {
    max-width: 52rem;
    margin: var(--space-7) 0;
    overflow: hidden;
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
    aspect-ratio: 16 / 10;
  }

  .case__hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* MDX body typography */
  .case__body :global(h2:not([class])) {
    margin: var(--space-8) 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--hairline);
  }

  .case__body :global(h3:not([class])) {
    margin: var(--space-6) 0 var(--space-3);
  }

  .case__body :global(p:not([class])),
  .case__body :global(ul:not([class])),
  .case__body :global(ol:not([class])) {
    margin: 0 0 var(--space-4);
  }

  .case__body :global(ul:not([class])),
  .case__body :global(ol:not([class])) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.25em;
  }

  .case__body :global(ul:not([class])) {
    list-style: disc;
  }

  .case__body :global(li::marker) {
    color: var(--muted);
  }

  .case__body :global(code) {
    padding: 0.1em 0.3em;
    border-radius: 4px;
    background: var(--accent-soft);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }

  .case__body :global(strong) {
    font-weight: 600;
  }

  .case__next {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: var(--hairline);
  }

  .case__next a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding: var(--space-5);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease);
  }

  .case__next a :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--accent);
  }

  @media (hover: hover) {
    .case__next a:hover {
      border-color: var(--accent);
    }
  }

  .case__next-title {
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .case__next-tagline {
    color: var(--muted);
    font-size: var(--text-small);
  }
</style>
