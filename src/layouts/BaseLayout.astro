---
/**
 * Page shell: head/SEO, fonts, theme bootstrap, skip link,
 * header, main and footer.
 */
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/global.css';

type Props = ComponentProps<typeof Seo>;

const seo = Astro.props;
// Vercel Web Analytics (cookieless). Only builds on Vercel serve /_vercel/insights/.
const analytics = process.env.VERCEL === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)" />

    <!-- Applies a saved theme before first paint (no flash), and marks JS as available. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        } catch {
          /* storage unavailable: follow the OS preference */
        }
      })();
    </script>
    <!-- Preload only the regular body face; other weights load on demand (spec §16). -->
    <Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo {...seo} />
    {analytics && <script is:inline defer src="/_vercel/insights/script.js" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 500;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  main:focus {
    outline: none;
  }
</style>
